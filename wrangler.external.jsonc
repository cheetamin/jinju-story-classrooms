{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jinju-story-staging",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {"FILE_STORAGE":"d1"},
  "d1_databases": [{"binding":"DB","database_name":"jinju-story-staging","database_id":"00000000-0000-4000-8000-000000000000","migrations_dir":"drizzle"}]
}
